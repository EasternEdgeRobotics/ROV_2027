# Turns any file into a C array in a header, so the bytes ship inside the
# executable. Run with cmake -P and:
#   INPUT   the file to embed
#   OUTPUT  the header to write
#   SYMBOL  the array's name. SYMBOL_len holds its size
#
# Every byte becomes five characters of source, so keep inputs small.

file(READ ${INPUT} HEX_BYTES HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ARRAY_BODY "${HEX_BYTES}")

file(WRITE ${OUTPUT}
  "#pragma once\n"
  "// Generated by cmake/embed_file.cmake. Do not edit.\n"
  "#include <cstddef>\n"
  "inline constexpr unsigned char ${SYMBOL}[] = {${ARRAY_BODY}};\n"
  "inline constexpr size_t ${SYMBOL}_len = sizeof(${SYMBOL});\n"
)
