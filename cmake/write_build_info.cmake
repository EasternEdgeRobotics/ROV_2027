# Stamps the build date into build_info.h. Runs on every build, but only
# rewrites the header when the date changes, so it costs a recompile once a
# day and not once a build.

string(TIMESTAMP EER_BUILD_DATE "%Y-%m-%d")

file(WRITE ${OUTPUT}.tmp
  "#pragma once\n"
  "// Generated by cmake/write_build_info.cmake. Do not edit.\n"
  "#define EER_BUILD_DATE \"${EER_BUILD_DATE}\"\n"
)

configure_file(${OUTPUT}.tmp ${OUTPUT} COPYONLY)
file(REMOVE ${OUTPUT}.tmp)
